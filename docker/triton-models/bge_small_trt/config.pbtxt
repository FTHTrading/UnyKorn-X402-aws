# BGE-small-en-v1.5 — TensorRT FP16 engine for Triton
# Built from ONNX model using trtexec v10.9.0 on RTX 5090 (Compute 12.0)
#
# Build command:
#   See scripts/build-trt-bge-small.sh
#
# Fixed shapes (1x128) — no dynamic batching.
# For variable-length inputs, pad/truncate to 128 tokens client-side.

name: "bge-small-trt"
platform: "tensorrt_plan"
max_batch_size: 0

input [
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [ 1, 128 ]
  },
  {
    name: "attention_mask"
    data_type: TYPE_INT64
    dims: [ 1, 128 ]
  },
  {
    name: "token_type_ids"
    data_type: TYPE_INT64
    dims: [ 1, 128 ]
  }
]

output [
  {
    name: "last_hidden_state"
    data_type: TYPE_FP32
    dims: [ 1, 128, 384 ]
  },
  {
    name: "pooler_output"
    data_type: TYPE_FP32
    dims: [ 1, 384 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

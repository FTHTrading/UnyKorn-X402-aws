# Riva Speech AI — ASR/TTS profile (optional)
# Requires NGC_API_KEY for model download
RIVA_GRPC_ENDPOINT=localhost:50051
RIVA_ASR_LANGUAGE=en-US
RIVA_ASR_MODEL=conformer
RIVA_TTS_LANGUAGE=en-US
RIVA_TTS_MODEL=fastpitch_hifigan
RIVA_TTS_SAMPLE_RATE=22050
RIVA_MODEL_VOLUME=riva-models

# Riva Speech NIMs — ASR/TTS profile
# Requires NGC_API_KEY for NIM container pulls

# ASR NIM — Parakeet CTC 1.1B (en-US)
RIVA_ASR_URL=http://localhost:9010
RIVA_ASR_GRPC=localhost:50051
RIVA_ASR_MODEL=parakeet-1-1b-ctc-en-us
RIVA_ASR_LANGUAGE=en-US

# TTS NIM — Magpie Multilingual
RIVA_TTS_URL=http://localhost:9020
RIVA_TTS_GRPC=localhost:50052
RIVA_TTS_MODEL=magpie-tts-multilingual
RIVA_TTS_LANGUAGE=en-US
RIVA_TTS_VOICE=English-US.Male-1
RIVA_TTS_SAMPLE_RATE=22050

# NGC_API_KEY=<your-ngc-key>

# Triton Inference Server — Optimized serving profile
# For pinned production-grade models (ONNX, TensorRT, TensorRT-LLM)
TRITON_HTTP_URL=http://localhost:8000
TRITON_GRPC_URL=grpc://localhost:8001
TRITON_METRICS_URL=http://localhost:8002/metrics
TRITON_MODEL_REPO_VOLUME=triton-models
TRITON_LOG_VERBOSE=0
TRITON_STRICT_MODEL_CONFIG=false

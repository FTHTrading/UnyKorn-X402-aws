# Finn Voice Pipeline — Riva NIM-integrated profile
# Routes speech through Riva NIMs when available, falls back to Whisper/Piper

# Primary speech backend
FINN_SPEECH_BACKEND=riva
RIVA_ASR_URL=http://localhost:9010
RIVA_TTS_URL=http://localhost:9020
RIVA_ASR_GRPC=localhost:50051
RIVA_TTS_GRPC=localhost:50052

# Fallback speech backend
FINN_SPEECH_FALLBACK=whisper+piper
FINN_WHISPER_MODEL=base
FINN_WHISPER_DEVICE=cuda:0
FINN_PIPER_MODEL=en_US-ryan-high.onnx
FINN_PIPER_MODEL_DIR=~/.finn/voice_models

# Voice tuning (Piper fallback)
FINN_PIPER_LENGTH_SCALE=0.92
FINN_PIPER_NOISE_SCALE=0.667
FINN_PIPER_NOISE_W=0.8

# Biometric auth (separate from TTS)
FINN_FACE_AUTH_THRESHOLD=0.40
FINN_VOICE_AUTH_THRESHOLD=0.65

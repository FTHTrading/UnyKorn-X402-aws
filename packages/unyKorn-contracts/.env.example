# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# accounts[0] — primary deployer / owner (UnyKorn controller)
PRIVATE_KEY=
# accounts[1] — secondary signer (e.g. GlacierMint operator)
PRIVATE_KEY_2=
# accounts[2] — tertiary signer (e.g. vault controller / treasury)
PRIVATE_KEY_3=

# ── RPCs ─────────────────────────────────────────────────────────
AVALANCHE_RPC=https://api.avax.network/ext/bc/C/rpc
POLYGON_RPC=https://polygon-rpc.com
BASE_RPC=https://mainnet.base.org

# ── Block Explorer API Keys ─────────────────────────────────────
SNOWTRACE_API_KEY=
POLYGONSCAN_API_KEY=
BASESCAN_API_KEY=

# ── Deployment Settings ─────────────────────────────────────────
REPORT_GAS=false
# Optional initial mint for FTH_USD (in human units, e.g. 1000000)
FTH_USD_INITIAL_MINT=0

# ── Deployed Contract Addresses (filled after deployment) ───────
# Avalanche
UNY_AVALANCHE_ADDRESS=0xc09003213b34c7bec8d2eddfad4b43e51d007d66
FTH_USD_AVALANCHE_ADDRESS=
# Polygon
UNY_POLYGON_ADDRESS=
FTH_USD_POLYGON_ADDRESS=
# Base
UNY_BASE_ADDRESS=
FTH_USD_BASE_ADDRESS=

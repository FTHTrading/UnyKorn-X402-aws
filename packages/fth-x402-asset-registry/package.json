{
  "name": "fth-x402-asset-registry",
  "version": "0.1.0",
  "private": true,
  "description": "FTH x402 Asset Registry — real-world asset records with USDF valuations, provenance, and x402-gated transfers",
  "main": "dist/fth-x402-asset-registry/src/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start": "node --enable-source-maps dist/fth-x402-asset-registry/src/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "fastify": "^5.8.4",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.10.0",
    "typescript": "^5.4.0"
  }
}

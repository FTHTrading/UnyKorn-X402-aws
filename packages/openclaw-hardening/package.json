    "./cron": "./src/validate-cron.mjs",
    "./models": "./src/validate-models.mjs",
    "./memory": "./src/validate-memory.mjs",
    "./plugins": "./src/validate-plugins.mjs",
    "./recovery": "./src/delivery-recovery.mjs",
    "./smoke": "./src/smoke-test.mjs",
    "./backup": "./src/backup.mjs"
  },
  "scripts": {
    "validate": "node src/validate-config.mjs",
    "smoke": "node src/smoke-test.mjs",
    "backup": "node src/backup.mjs",

{
  "name": "@unykorn/openclaw-hardening",
  "version": "1.0.0",
  "description": "OpenClaw platform hardening: config validation, delivery mode enforcement, cron model resolution, memory provider checks, operator tooling",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./constants": "./src/constants.mjs",

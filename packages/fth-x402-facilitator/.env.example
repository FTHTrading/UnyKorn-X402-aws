# FTH x402 Facilitator — Environment Variables
# Copy to .env and fill in values

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=fth_x402
PGUSER=fth
PGPASSWORD=changeme

# Server
PORT=3100
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGIN=*

# Required Security Credentials (fail-closed)
DATABASE_URL=postgresql://fth:changeme@localhost:5432/fth_x402
FTH_SIGNING_KEY=your_facilitator_ed25519_signing_key_here
FTH_SERVICE_SECRET=your_hmac_service_secret_here
ADMIN_API_TOKEN=your_admin_bearer_token_here

# UnyKorn L1
UNYKORN_RPC_URL=https://rpc.l1.unykorn.org
UNYKORN_RPC_FALLBACK_URL=
UNYKORN_CHAIN_ID=7331
UNYKORN_EXPLORER_URL=https://explorer.unykorn.org
UNYKORN_TREASURY_ADDRESS=uny1_DEMO_TREASURY
UNYKORN_CONFIRMATIONS=1

# Base mainnet (later external rail adapter)
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453
BASE_USDC_ADDRESS=0x833589fCD6EDB6E08f4c7C32D4f71b54bdA02913
BASE_TREASURY_ADDRESS=

# Stellar (Phase 2)
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# XRPL (Phase 3)
# XRPL_WSS_URL=wss://s1.ripple.com

# Cloudflare (gateway deployment)
# CF_API_TOKEN=     # <-- NEVER commit. Use `wrangler secret` or env.
# CF_ACCOUNT_ID=

# Facilitator signing key (Ed25519)
# FACILITATOR_SECRET_KEY=   # base64 encoded 64-byte secret key

# xAI / Grok (added 2026-06-01)
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL_DEFAULT=grok-4
GROK_BUILDER_MODEL=grok-build-0.1

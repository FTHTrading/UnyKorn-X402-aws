# ===========================================================================
# NVIDIA RTX 5090 Workstation — Master Environment Template
# ===========================================================================
# Copy to .env and fill in values. Used by docker-compose files and scripts.
# ===========================================================================

# ── GPU / CUDA ────────────────────────────────────────────────
NVIDIA_DRIVER_VERSION=581.95
CUDA_VERSION=13.2
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ── WSL2 ─────────────────────────────────────────────────────
WSL_DISTRO=Ubuntu
WSL_PROJECT_ROOT=/home/kevan/projects

# ── Ollama (dev inference) ────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Triton Inference Server (optimized inference) ─────────────
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:25.01-py3
TRITON_HTTP_PORT=8000
TRITON_GRPC_PORT=8001
TRITON_METRICS_PORT=8002
TRITON_MODEL_REPO=/models

# ── TensorRT-LLM ─────────────────────────────────────────────
TRTLLM_IMAGE=nvcr.io/nvidia/tritonserver:25.01-trtllm-python-py3
TRTLLM_ENGINE_DIR=/engines

# ── Riva (optional speech) ────────────────────────────────────
RIVA_IMAGE=nvcr.io/nvidia/riva/riva-speech:2.18.0
RIVA_GRPC_PORT=50051
RIVA_ASR_ENABLED=true
RIVA_TTS_ENABLED=true
# NGC_API_KEY=<your-ngc-key>  # Required for Riva model downloads

# ── OpenClaw ──────────────────────────────────────────────────
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_DEFAULT_MODEL=ollama/qwen2.5:7b

# ── Finn ──────────────────────────────────────────────────────
FINN_SPEECH_BACKEND=riva
FINN_SPEECH_FALLBACK=whisper+piper
FINN_RIVA_ENDPOINT=localhost:50051
FINN_WHISPER_MODEL=base
FINN_PIPER_MODEL=en_US-ryan-high.onnx

# ── Open WebUI ────────────────────────────────────────────────
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_OLLAMA_URL=http://localhost:11434
OPEN_WEBUI_TRITON_URL=http://localhost:8000

# ── Profiling ─────────────────────────────────────────────────
NSIGHT_REPORT_DIR=C:\Users\Kevan\nsight-reports
